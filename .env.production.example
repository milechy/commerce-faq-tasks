PORT=3100
LOG_LEVEL=info
NODE_ENV=production

# ==== CORS ====
ALLOWED_ORIGINS=http://65.108.159.161,http://65.108.159.161:5173

# ==== Data (VPS localhost) ====
ES_URL=http://localhost:9200
DATABASE_URL=postgres://postgres:CHANGE_ME@127.0.0.1:5432/faq
HYBRID_TIMEOUT_MS=300
HYBRID_MOCK_ON_FAILURE=0

# ==== Cross-encoder ====
CE_ENGINE=heuristic

# ==== Auth ====
AGENT_API_KEY=CHANGE_ME
API_KEY_TENANT_ID=partner

# ==== 必須 secrets（fail-closed）====
# [P1] これらが未設定だと本番はブートしない（src/lib/startup/authSecretsGuard.ts /
# src/lib/startup/internalSecretGuard.ts / config/env.ts が起動時に exit する）。
# デプロイ前に必ず実値を投入すること。プレースホルダのままでは起動失敗する。
#
# Supabase（管理面 JWT 検証・サーバ側管理操作）
SUPABASE_URL=
# 管理面 JWT (HS256) の署名検証鍵。未設定だと管理APIが 503 fail-closed になる。
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
# widget.js 埋め込みトークンの署名鍵（管理APIと同じ鍵で署名しないための専用 secret）
WIDGET_JWT_SECRET=
# /internal/* の HMAC 認証鍵。未設定だと /internal/ga4/* が 500 になり続けるため起動を止める。
INTERNAL_API_HMAC_SECRET=
# 知識/書籍テキストの AES-256-GCM 暗号化鍵（64文字hex = 256bit）。
# 生成: python3 -c "import secrets; print(secrets.token_hex(32))"
# 未設定だと保存経路が throw（平文保存禁止）＆ 起動も止まる。
KNOWLEDGE_ENCRYPTION_KEY=

# TENANT_CONFIGS_JSON (recommended for production — overrides AGENT_API_KEY)
# Generate hash: node -e "console.log(require('crypto').createHash('sha256').update('YOUR_KEY').digest('hex'))"
# TENANT_CONFIGS_JSON=[{"tenantId":"partner","name":"Partner","plan":"growth","features":{"avatar":false,"voice":false,"rag":true},"security":{"apiKeyHash":"CHANGE_ME","hashAlgorithm":"sha256","allowedOrigins":["http://65.108.159.161","http://65.108.159.161:5173"],"rateLimit":60,"rateLimitWindowMs":60000},"enabled":true}]

# ==== Monitoring ====
SLACK_WEBHOOK_URL=

DEFAULT_TENANT_ID=partner

# ==== Billing ====
# PR-7(2026-08-25収益監査): このセクションが本番テンプレートに存在しなかったため、
# STRIPE_SECRET_KEY/STRIPE_WEBHOOK_SECRET 未設定のまま「請求バッチが無言で
# 存在しなくなる」「webhookが常時500になる」状態に気づけない導線になっていた。
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BILLING_PORTAL_RETURN_URL=
STRIPE_METERED_PRICE_ID=
# 確定価格(.claude/rules/billing.md §7)の price ID。Standard/Growth の3本
# (基本料 + テキスト超過 + アバター超過)が揃っていないとオンボーディングは
# 作成せずに失敗する(一部だけ設定して「欠けた次元が無言で請求されない」状態を作らないため)。
STRIPE_PRICE_STARTER_TEXT=
STRIPE_PRICE_STANDARD_BASE_MONTHLY=
STRIPE_PRICE_STANDARD_BASE_ANNUAL=
STRIPE_PRICE_STANDARD_TEXT_OVERAGE=
STRIPE_PRICE_STANDARD_AVATAR_OVERAGE=
STRIPE_PRICE_GROWTH_BASE_MONTHLY=
STRIPE_PRICE_GROWTH_BASE_ANNUAL=
STRIPE_PRICE_GROWTH_TEXT_OVERAGE=
STRIPE_PRICE_GROWTH_AVATAR_OVERAGE=
# 月額固定費按分(未設定/0なら無効・デフォルトOFF)
LEMONSLICE_MONTHLY_FEE_JPY=
LIVEKIT_MONTHLY_FEE_JPY=
PLATFORM_MONTHLY_FEE_JPY=
# A2A-0i: 固定費クォータ監視(billingHealthCheck.ts fetchFixedCostQuotaStatus)。
# 上げ下げの判断材料としてのSlack通知/管理画面カードに使う込み枠(上限ではない)。
# LemonSlice: $100/月プランの込みクレジット数。未設定時は15000(既定契約)を使う。
LEMONSLICE_MONTHLY_CREDIT_QUOTA=
# LiveKit: $50/月プランの込み枠(room発行件数)。実際の契約上の込み枠が未確定なため
# デフォルト値を置いていない。未設定の間は監視自体が沈黙する(誤ったデフォルトで
# 誤警告を出すより、判明するまで沈黙する方を選んでいる)。
LIVEKIT_MONTHLY_ROOM_QUOTA=

# ==== Phase27: Qwen OCR ====
QWEN_API_KEY=
OPENAI_API_KEY=
