# R2C / RAJIUCE — Environment Variables
# Updated: 2026-04-21 (Phase A Day 7: 13変数追加, stale 2変数削除)
# Copy to .env and fill in values before deploying.

# ==== Core ====
PORT=3100
LOG_LEVEL=info
NODE_ENV=development
LOGS_DIR=logs

# ==== CORS ====
# カンマ区切りで複数オリジン: http://localhost:8080,https://example.com
ALLOWED_ORIGINS=http://localhost:8080
API_BASE_URL=http://localhost:3100

# ==== Database ====
DATABASE_URL=postgres://postgres:pass@127.0.0.1:5434/faq

# ==== Elasticsearch ====
ES_URL=http://localhost:9200
# [DEPRECATED Phase69-2-E] ES_FAQ_INDEX は FAQ 検索では使用しない。
# FAQ の ES index はテナント別 `faq_${tenantId}` に固定（read/write/reindex 全て一致）。
# 命名規則の正典: src/search/langIndex.ts resolveFaqWriteIndex / SCRIPTS/sync-es.ts。
# この変数は book-pipeline (Phase44/47) が暫定的に参照するのみ。新規コードでは使わないこと。
ES_FAQ_INDEX=faq

# ==== Hybrid Search ====
HYBRID_TIMEOUT_MS=300
HYBRID_MOCK_ON_FAILURE=1
LANG_SEARCH_ENABLED=false
RAGSTATS_TOPLEVEL_COMPAT=false

# ==== Cross-encoder ====
CE_MODEL_PATH=
CE_ENGINE=heuristic
CE_VOCAB_PATH=
CE_INPUT_IDS_NAME=input_ids
CE_TOKEN_TYPE_IDS_NAME=token_type_ids
CE_ATTENTION_MASK_NAME=attention_mask
CE_OUTPUT_NAME=logits
CE_OUTPUT_INDEX=0
CE_MAX_BATCH_SIZE=16
CE_MAX_SEQ_LEN=512
CE_MIN_QUERY_CHARS=2
CE_CANDIDATES=20

# ==== Auth — API Key ====
AGENT_API_KEY=
API_KEY_TENANT_ID=
# 複数テナント: JSON配列形式
API_KEY=
API_KEY_2=
API_KEY_2_TENANT_ID=
TENANT_CONFIGS_JSON=
SUPER_ADMIN_BYPASS=false

# ==== Auth — Basic ====
BASIC_USER=
BASIC_PASS=
AGENT_BASIC_USER=
AGENT_BASIC_PASSWORD=
BASIC_AUTH_TENANT_ID=

# ==== Auth — Supabase ====
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_JWT_SECRET=your-jwt-secret
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# production 必須（未設定だと起動時に exit(1)）。SUPABASE_JWT_SECRET とは必ず別の値にする —
# この鍵で署名したトークンは widget.js として公開配布されるため、共用すると公開トークンで管理面に到達できる。
WIDGET_JWT_SECRET=
# Admin UI (VITE_ prefix — set in admin-ui/.env.local)
# VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key

# ==== LLM — Primary (Groq) ====
GROQ_API_KEY=gsk_xxxx
GROQ_MODEL_8B=llama-3.1-8b-instant
GROQ_MODEL_70B=llama-3.3-70b-versatile
GROQ_ANSWER_20B_MODEL=llama3-8b-8192
GROQ_ANSWER_120B_MODEL=llama-3.3-70b-versatile
GROQ_PLANNER_20B_MODEL=llama3-8b-8192
GROQ_PLANNER_120B_MODEL=llama-3.3-70b-versatile
GROQ_FAQ_GEN_MODEL=llama-3.3-70b-versatile

# ==== LLM — Alternate (OpenAI-compatible) ====
LLM_API_KEY=
LLM_API_BASE=
LLM_CHAT_MODEL=
LLM_MODEL_20B=
LLM_MODEL_120B=
LLM_FORCE_PLANNER_ROUTE=

# ==== LLM — Planner Feature Flags ====
AGENT_PLANNER_LLM_ENABLED=false
AGENT_PLANNER_MODEL=

# ==== Embeddings (OpenAI) ====
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ==== OCR (Qwen) ====
QWEN_API_KEY=

# ==== Judge (Gemini) — Phase45 ====
# GEMINI_API_KEY は src/lib/gemini/client.ts で使用中（削除不可）
GEMINI_API_KEY=your-gemini-api-key
FEEDBACK_AI_MODEL=

# ==== 書籍の心理学原則への構造化 — Phase47 Stream B ====
# 書籍PDFの取り込みは2系統ある(.claude/rules/knowledge.md 参照):
#   1. アップロード時に自動実行(embedAndStore) — principle を持たない
#   2. POST /v1/admin/knowledge/structurize-trigger の手動実行(bookStructurizer)
#      — principle/situation/example 等を付与する。この変数が true のときだけ動く
# searchPrincipleChunks(心理学原則の検索)は 2 の行にしかヒットしないため、
# 未設定のままだとトリガーを押しても structurizeBook が無言で即 return する。
BOOK_STRUCTURIZE_ENABLED=false

DEFAULT_TENANT_ID=

# ==== Avatar — Phase40-41 ====
PREMIUM_AVATAR_PRICE_CENTS=100
FAL_KEY=
FREEPIK_API_KEY=
LIVEKIT_URL=wss://your-livekit.livekit.cloud
LIVEKIT_WS_URL=wss://your-livekit.livekit.cloud
LIVEKIT_API_KEY=your-livekit-key
LIVEKIT_API_SECRET=your-livekit-secret
LIVEKIT_ACCESS_TOKEN=
LIVEKIT_ROOM_PREFIX=r2c-
FISH_AUDIO_API_KEY=your-fish-audio-key
FISH_AUDIO_REFERENCE_ID=
# 無料期間(2026-08-31まで)は s2.1-pro-free。有料切替時は s2.1-pro に変更(agent.py側にも同じ値を設定)
FISH_AUDIO_TTS_MODEL=s2.1-pro-free
ANAM_API_KEY=
LEONARDO_API_KEY=
# LemonSlice (アバター配信サービス)
LEMON_SLICE_ENDPOINT=
LEMON_SLICE_READINESS_URL=

# ==== Billing — Phase32 ====
STRIPE_SECRET_KEY=sk_test_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx
BILLING_PORTAL_RETURN_URL=https://admin.r2c.biz/billing
# PR-7: テナントオンボーディング(POST /v1/admin/billing/onboard)で作成する
# metered Subscription の price ID(Stripe Dashboardで従量課金priceを作成して設定)。
# 全プラン共通の単一priceだった旧実装の名残。Starter で STRIPE_PRICE_STARTER_TEXT が
# 未設定のときのフォールバックとしてのみ残しており、単価が旧プレースホルダのままなので
# 本番では STRIPE_PRICE_STARTER_TEXT を必ず設定すること。
STRIPE_METERED_PRICE_ID=price_xxxx
# 確定価格(.claude/rules/billing.md §7)の price ID。プラン倍率は price 側の単価に
# 織り込まれている(テキスト Starter ¥20 / Standard ¥25 / Growth ¥30)ため、
# 数量にも倍率を掛けると二重適用になる。対応表は planPricing.ts が唯一の出どころ。
# BASE_* は metered ではない定額。Stripe が毎期自動で請求するので usage record を送らない。
STRIPE_PRICE_STARTER_TEXT=price_xxxx
STRIPE_PRICE_STANDARD_BASE_MONTHLY=price_xxxx
STRIPE_PRICE_STANDARD_BASE_ANNUAL=price_xxxx
STRIPE_PRICE_STANDARD_TEXT_OVERAGE=price_xxxx
STRIPE_PRICE_STANDARD_AVATAR_OVERAGE=price_xxxx
STRIPE_PRICE_GROWTH_BASE_MONTHLY=price_xxxx
STRIPE_PRICE_GROWTH_BASE_ANNUAL=price_xxxx
STRIPE_PRICE_GROWTH_TEXT_OVERAGE=price_xxxx
STRIPE_PRICE_GROWTH_AVATAR_OVERAGE=price_xxxx

# ==== PostHog (Phase A) ====
# R2C運営用 LLM Analytics送信プロジェクト
POSTHOG_PROJECT_API_KEY=phc_xxxx
POSTHOG_API_HOST=https://eu.i.posthog.com

# ==== GA4 / Internal API (Phase A) ====
# GA4 サービスアカウント JSON を Base64 エンコードして設定
GOOGLE_APPLICATION_CREDENTIALS_JSON=
# Cloudflare Workers → VPS 間 HMAC-SHA256 認証シークレット
INTERNAL_API_HMAC_SECRET=

# ==== Monitoring ====
SLACK_WEBHOOK_URL=
# R2C #r2c チャンネル専用 Incoming Webhook (24h 自走通知用)
SLACK_WEBHOOK_URL_R2C=
SENTIMENT_SERVICE_URL=

# ==== Knowledge Encryption ====
KNOWLEDGE_ENCRYPTION_KEY=

# ==== Notion Integration ====
NOTION_API_KEY=
NOTION_DB_FAQ_ID=
NOTION_DB_PRODUCTS_ID=
NOTION_DB_LP_POINTS_ID=
NOTION_DB_TUNING_TEMPLATES_ID=
NOTION_DB_CLARIFY_LOG_ID=
NOTION_DB_SALES_LOG_ID=

# ==== n8n Webhook Integration ====
N8N_WEBHOOK_URL=
N8N_WEBHOOK_AUTH_HEADER=
N8N_WEBHOOK_TIMEOUT_MS=5000
# 原価表示用のマージン倍率。cost_total_cents = 実原価 × この値。
# ★テナントへの請求単価ではない★ — 上げ下げを「値上げ/値下げ」として扱わないこと
# (CLAUDE.md)。請求額は Stripe の price 側が唯一の出どころ。
# 本番実値は 10（2026-09-04 実測）。以前ここは 0.3 になっていたが、
# 0.3 だと cost_total_cents が実原価を下回り、粗利計算が成立しない。
MARGIN_RATE=10

# USD→JPY の換算レート（未設定時 150）。原価は USD、売上は JPY のため粗利算出に必要。
# 唯一の実装は src/lib/billing/fx.ts。★レート履歴を持たないので、変更すると
# 過去月の粗利も後から変わる★
USD_JPY_RATE=150

# ==== Judge ====
# 離脱セッション自動評価スイープの段階開放。カンマ区切りテナントID。
# 未設定時はr2c_defaultのみを対象にする。
JUDGE_SWEEP_TENANTS=

# ==== Search Integrations ====
# OpenClaw (外部検索)
OPENCLAW_ENABLED=false
OPENCLAW_RL_URL=
OPENCLAW_TENANTS=
# OpenViking (外部検索)
OPENVIKING_ENABLED=false
OPENVIKING_URL=
OPENVIKING_TENANTS=
OPENVIKING_TIMEOUT_MS=3000

# ==== Anam アバターの回答経路 (E5) ====
# /api/avatar/chat-stream は RAG(FAQ/pgvector/learned_memory/tuning_rules)を介さない
# Groq 直呼び出し経路。true にすると顧客に知識ゼロの回答が出るため既定で封鎖している。
# 有効化する前に、本体API /api/chat と同じ知識経路をこのルートにも通すこと。
ANAM_CHAT_STREAM_ENABLED=false

# ==== Learned Memory (Phase71-A: メモリベース学習ループ) ====
# Judge高スコア会話を蒸留し learned_memory に蓄積、RAG検索へ還元する。
LEARNED_MEMORY_ENABLED=false
# 対象テナント (カンマ区切り。'*' で全テナント)
LEARNED_MEMORY_TENANTS=
# 検索マージを無効化したい場合のみ false (蒸留だけ先行可能)。既定 true
LEARNED_MEMORY_READ_ENABLED=true
# 蒸留対象とする Judge overall_score の下限 (0-100)。既定 80
LEARNED_MEMORY_THRESHOLD=80
# 学習メモリの score 重み (curated FAQ より優先しない)。0-1。既定 0.9
LEARNED_MEMORY_WEIGHT=0.9

# ==== オフサイトバックアップ (Cloudflare R2) — SCRIPTS/backup-offsite.sh ====
# ローカル /backup/pg_*.sql.gz を物理的に離れた R2 へ複製し、VPS 全損時のDB喪失を防ぐ。
# 値は本番 .env / CI secrets にのみ置く。ここはプレースホルダ（実値をコミットしない）。
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# オフサイト側の保持日数（ローカル保持=7日 より長く。既定30）
OFFSITE_RETENTION_DAYS=30
# バケット内のプレフィックス（既定 postgres）
OFFSITE_PREFIX=postgres

# ==== 外部死活監視 (UptimeRobot) — SCRIPTS/setup-uptime-monitoring.sh ====
# VPS の外側から /health 等を監視する。VPS 全損時でも通知が届くようにするため必須。
UPTIMEROBOT_API_KEY=
UPTIMEROBOT_ALERT_CONTACT_ID=
MONITOR_INTERVAL_SEC=300
MONITOR_API_URL=https://api.r2c.biz/health
MONITOR_ADMIN_URL=https://admin.r2c.biz
MONITOR_WIDGET_URL=

# ==== フォールバック死活監視 — SCRIPTS/external-healthcheck.sh ====
# UptimeRobot を使わない/使えない場合。別ホストや GitHub Actions から回す dead-man's-switch。
# webhook はスクリプトに書かず、実行環境の env / CI secrets に置くこと。
HEALTHCHECK_URL=https://api.r2c.biz/health
ALERT_WEBHOOK_URL=
FAIL_THRESHOLD=3

# ==== TestSprite MCP (.mcp.json) — ローカル開発用 ====
# .mcp.json の TestSprite サーバは API_KEY を ${TESTSPRITE_API_KEY} で参照する。値はここに書かず、各自のシェル環境 / .env に設定すること。
TESTSPRITE_API_KEY=

# ==== post-deploy-smoke.sh のテナント認証チェック (GID 1218171750803663) ====
# 実在テナントのAPIキーで /api/widget/features を叩き、seedTenantsFromDBの
# 一過性欠落等でテナント認証経路が壊れていないかをデプロイ後に確認する。
# LLM呼び出しは行わないエンドポイントを使うため、他テナントに課金・利用量への
# 影響を与えない専用の低権限テナント(例: free_adプランの検証用テナント)の
# APIキーを設定すること。未設定時はこのチェックをスキップする(必須ではない)。
SMOKE_TEST_TENANT_API_KEY=
